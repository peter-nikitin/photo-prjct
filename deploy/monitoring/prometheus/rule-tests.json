{
  "rule_files": [
    "rules.yml"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "expiring TLS remains evaluated during five-minute scrape delivery lag",
      "interval": "5m",
      "input_series": [
        {
          "series": "findme_probe_tls_days_remaining{check=\"canonical-health\"}",
          "values": "10 _ _"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "6m",
          "alertname": "TLSCertificateExpiring",
          "exp_alerts": [
            {
              "exp_labels": {
                "project": "findme-photo",
                "severity": "critical",
                "check": "canonical-health"
              },
              "exp_annotations": {
                "summary": "TLS certificate lifetime is below fourteen days."
              }
            }
          ]
        },
        {
          "eval_time": "11m",
          "alertname": "TLSCertificateExpiring",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "healthy TLS remains finite during five-minute scrape delivery lag",
      "interval": "5m",
      "input_series": [
        {
          "series": "findme_probe_tls_days_remaining{check=\"canonical-health\"}",
          "values": "30 _ _"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "min_over_time(findme_probe_tls_days_remaining{check=\"canonical-health\"}[10m])",
          "eval_time": "6m",
          "exp_samples": [
            {
              "labels": "{check=\"canonical-health\"}",
              "value": 30
            }
          ]
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "6m",
          "alertname": "TLSCertificateExpiring",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "public failure after success then recovery",
      "interval": "1m",
      "input_series": [
        {
          "series": "findme_probe_success{check=\"canonical-health\"}",
          "values": "1 0+0x10 1+0x5"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "9m",
          "alertname": "PublicServiceUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "11m",
          "alertname": "PublicServiceUnavailable",
          "exp_alerts": [
            {
              "exp_labels": {
                "project": "findme-photo",
                "severity": "critical",
                "check": "canonical-health",
                "notification": "actionable",
                "incident": "public-service"
              },
              "exp_annotations": {
                "summary": "Public HTTPS attempts have failed throughout ten minutes."
              }
            }
          ]
        },
        {
          "eval_time": "12m",
          "alertname": "PublicServiceUnavailable",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "public missing is separate",
      "interval": "1m",
      "input_series": [],
      "alert_rule_test": [
        {
          "eval_time": "11m",
          "alertname": "PublicServiceUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "16m",
          "alertname": "PublicObservationsMissing",
          "exp_alerts": [
            {
              "exp_labels": {
                "project": "findme-photo",
                "severity": "critical",
                "check": "canonical-health"
              },
              "exp_annotations": {
                "summary": "Public HTTPS observations are missing; availability is unconfirmed."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Commerce sustained failure recovery and overdue",
      "interval": "1m",
      "input_series": [
        {
          "series": "commerce_worker_alive{check=\"canonical-commerce\"}",
          "values": "1 0+0x5 1+0x5"
        },
        {
          "series": "commerce_oldest_ready_age_seconds{check=\"canonical-commerce\"}",
          "values": "0 600+0x10 0+0x5"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "4m",
          "alertname": "CommerceWorkerUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "5m",
          "alertname": "CommerceWorkerUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "7m",
          "alertname": "CommerceWorkerUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "7m",
          "alertname": "CommerceReadyWorkOverdue",
          "exp_alerts": [
            {
              "exp_labels": {
                "project": "findme-photo",
                "severity": "critical",
                "check": "canonical-commerce",
                "notification": "actionable",
                "incident": "commerce-processing"
              },
              "exp_annotations": {
                "summary": "Commerce ready work is older than three hundred seconds."
              }
            }
          ]
        },
        {
          "eval_time": "17m",
          "alertname": "CommerceReadyWorkOverdue",
          "exp_alerts": []
        }
      ]
    },
