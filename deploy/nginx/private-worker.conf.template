server {
    listen 8443 ssl;
    server_name findme-photo.ru;
    access_log off;
    error_log /dev/null emerg;
    ssl_certificate /etc/letsencrypt/live/photo-prjct/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/photo-prjct/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 384k;
    client_body_buffer_size 384k;
    proxy_connect_timeout 30s;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location ^~ /internal/photo-processing/v1/ {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host findme-photo.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-FindMe-Worker-Transport private-tls;
    }
    location / {
        return 404;
    }
}
