# Paid watermarked previews remain inactive until this ordered rollout is complete:
# 1. Approve non-placeholder overlay assets and their declared checksums.
# 2. Explicitly configure the optional 2/generate_watermarked_preview/1 worker identity.
# 3. Run one real staff-only smoke with the active worker.
# 4. Enable the paid-watermarked-previews public gate.
# Do not add the optional identity or enable the public gate before the preceding checks.
PHOTO_WORKER_BUILD=capture-metadata-v1
PHOTO_WORKER_LEASE_SECONDS=120
PHOTO_WORKER_PROCESSOR_IDENTITIES=1/capture_metadata/2,2/generate_preview/1,2/face_embedding/3
PHOTO_WORKER_PROCESSOR_TYPE=capture_metadata
PHOTO_WORKER_PROCESSOR_TYPES=selfie_query,face_embedding,capture_metadata,generate_preview
