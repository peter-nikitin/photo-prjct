[Unit]
Description=FindMe public HTTPS health probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/findme-public-probe/current/monitor_public_health.py --auth vm-metadata --target https://findme-photo.ru/health/ --folder-id b1g2qttgfhb4gdunvlge --check canonical-health
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=64M
CPUQuota=10%
TasksMax=16
TimeoutStartSec=90
