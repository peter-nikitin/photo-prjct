server_tokens off;

map $uri $selfie_search_access_client_address {
    default $remote_addr;
    ~^/events/[^/]+/selfie-search(?:/|$) "-";
    ~^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) "-";
    ~^/orders/[^/]+/download/$ "-";
}

map $uri $selfie_search_access_remote_user {
    default $remote_user;
    ~^/events/[^/]+/selfie-search(?:/|$) "-";
    ~^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) "-";
    ~^/orders/[^/]+/download/$ "-";
}

map $uri $selfie_search_access_request {
    default $request;
    ~^/events/[^/]+/selfie-search/$ "$request_method <selfie-search>";
    ~^/events/[^/]+/selfie-search/[^/]+(?:/|$) "$request_method <selfie-search>";
    ~^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) "$request_method <order-access>";
    ~^/orders/[^/]+/download/$ "$request_method <order-archive>";
}

map $uri $selfie_search_access_referrer {
    default $http_referer;
    ~^/events/[^/]+/selfie-search(?:/|$) "-";
    ~^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) "-";
    ~^/orders/[^/]+/download/$ "-";
}

map $uri $selfie_search_access_user_agent {
    default $http_user_agent;
    ~^/events/[^/]+/selfie-search(?:/|$) "-";
    ~^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) "-";
    ~^/orders/[^/]+/download/$ "-";
}

log_format selfie_search_safe '$selfie_search_access_client_address - $selfie_search_access_remote_user [$time_local] '
    '"$selfie_search_access_request" $status $body_bytes_sent '
    '"$selfie_search_access_referrer" "$selfie_search_access_user_agent" $request_time';

upstream django_upstream {
    server web:8000;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log selfie_search_safe;

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_DOMAIN}${PUBLIC_DOMAIN_ALIAS_SERVER_NAME};
    access_log /var/log/nginx/access.log selfie_search_safe;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Order access grants are bearer URLs. Keep the HTTP redirect private too.
    location ~ ^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) {
        error_log /dev/null emerg;

        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Vary "Cookie" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 308 https://${PUBLIC_DOMAIN}$request_uri;
    }

    # Purchase-browser archive URLs contain a public Order number. Keep redirects private.
    location ~ ^/orders/[^/]+/download/$ {
        error_log /dev/null emerg;

        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Vary "Cookie" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 308 https://${PUBLIC_DOMAIN}$request_uri;
    }

    location / {
        return 308 https://${PUBLIC_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    access_log /var/log/nginx/access.log selfie_search_safe;

    ssl_certificate /etc/letsencrypt/live/photo-prjct/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/photo-prjct/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 444;
}

${HTTPS_ALIAS_SERVER}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PUBLIC_DOMAIN};
    access_log /var/log/nginx/access.log selfie_search_safe;

    ssl_certificate /etc/letsencrypt/live/photo-prjct/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/photo-prjct/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 25m;

    proxy_hide_header Referrer-Policy;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # The worker reaches Django through the private Compose network, never the public edge.
    location ^~ /internal/photo-processing/ {
        return 404;
    }

    location = /metrics/ {
        return 404;
    }

    # Submission uploads can contain private request metadata. Keep edge failures out of logs.
    location ~ ^/events/[^/]+/selfie-search/$ {
        error_log /dev/null emerg;

        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Bearer URLs are secrets. Do not persist a raw request URI if this upstream is unavailable.
    location ~ ^/events/[^/]+/selfie-search/[^/]+(?:/|$) {
        error_log /dev/null emerg;

        # Bearer URLs must not be sent as a referrer to any subsequent request.
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Order access grants are bearer URLs. Enforce privacy before Django, including errors.
    location ~ ^/orders/[^/]+/access/[^/]+/[^/]+(?:/|$) {
        error_log /dev/null emerg;

        proxy_hide_header Cache-Control;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Vary;
        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Vary "Cookie" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Purchase-browser archives retain the same private boundary without changing other traffic.
    location ~ ^/orders/[^/]+/download/$ {
        error_log /dev/null emerg;

        proxy_hide_header Cache-Control;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Vary;
        proxy_hide_header X-Content-Type-Options;
        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Vary "Cookie" always;
        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 8080;
    server_name _;
    access_log /var/log/nginx/access.log selfie_search_safe;

    location = /health/ {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /metrics/ {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host ${PUBLIC_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-SSL on;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        return 444;
    }
}
