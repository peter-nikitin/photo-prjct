ARG WORKER_BASE_IMAGE=ghcr.io/peter-nikitin/photo-prjct-worker-base:latest
FROM ${WORKER_BASE_IMAGE}

WORKDIR /worker
COPY --chown=worker:worker src/worker/photo_worker ./photo_worker
RUN --network=none python -m photo_worker.runtime_contract
RUN --network=none python -m photo_worker.model_smoke

ARG RELEASE_SHA
LABEL org.opencontainers.image.revision=$RELEASE_SHA
LABEL ru.findme-photo.historical-adaface-contract="vector-only-v1"
CMD ["python", "-m", "photo_worker"]
