status:
  port: 16241
storages:
  - name: metrics_buffer
    plugin: fs
    config:
      directory: /var/lib/yandex/unified_agent/metrics_buffer
      max_partition_size: 128mb
      max_segment_size: 16mb
  - name: findme_prometheus_buffer
    plugin: fs
    config:
      directory: /var/lib/yandex/unified_agent/findme_prometheus_buffer
      max_partition_size: 100mb
      max_segment_size: 10mb
channels:
  - name: cloud_monitoring
    channel:
      pipe:
        - storage_ref: {name: metrics_buffer}
      output:
        plugin: yc_metrics
        config:
          folder_id: __YANDEX_CLOUD_FOLDER_ID__
          iam: {cloud_meta: {}}
  - name: findme_prometheus_remote_write
    channel:
      pipe:
        - storage_ref: {name: findme_prometheus_buffer}
      output:
        plugin: metrics
        config:
          url: https://monitoring.api.cloud.yandex.net/prometheus/workspaces/__PROMETHEUS_WORKSPACE_ID__/api/v1/write
          set_host_label:
          iam: {cloud_meta: {}}
routes:
  - input:
      plugin: linux_metrics
      config: {poll_period: 60s, namespace: sys}
    channel:
      channel_ref: {name: cloud_monitoring}
  - input:
      plugin: agent_metrics
      config: {poll_period: 60s, namespace: ua}
    channel:
      pipe:
        - filter:
            plugin: filter_metrics
            config: {match: "{scope=health}"}
      channel_ref: {name: cloud_monitoring}
  - input:
      plugin: metrics_pull
      config:
        url: http://127.0.0.1:18081/metrics
        format: {prometheus: {}}
        poll_period: 60s
        namespace: origin
    channel:
      channel_ref: {name: cloud_monitoring}
  - input:
      plugin: metrics_pull
      config:
        url: http://127.0.0.1:18081/imgproxy-metrics
        format: {prometheus: {}}
        poll_period: 60s
        namespace: imgproxy
    channel:
      channel_ref: {name: cloud_monitoring}
  - input:
      plugin: metrics_pull
      config:
        url: http://127.0.0.1:19091/metrics
        format: {prometheus: {}}
        poll_period: 300s
        timeout: 30s
        prometheus_config: {job_name: findme-public}
    channel:
      channel_ref: {name: findme_prometheus_remote_write}
  - input:
      plugin: linux_metrics
      config:
        poll_period: 60s
        namespace: sys
        prometheus_config: {job_name: findme-image-linux}
    channel:
      channel_ref: {name: findme_prometheus_remote_write}
  - input:
      plugin: metrics_pull
      config:
        url: http://127.0.0.1:18081/metrics
        format: {prometheus: {}}
        poll_period: 60s
        timeout: 10s
        namespace: origin
        prometheus_config: {job_name: findme-image-origin}
    channel:
      channel_ref: {name: findme_prometheus_remote_write}
  - input:
      plugin: metrics_pull
      config:
        url: http://127.0.0.1:18081/imgproxy-metrics
        format: {prometheus: {}}
        poll_period: 60s
        timeout: 10s
        namespace: imgproxy
        prometheus_config: {job_name: findme-imgproxy}
    channel:
      channel_ref: {name: findme_prometheus_remote_write}
