    {
      "name": "imgproxy latency fires on sustained slow high-volume requests",
      "interval": "1m",
      "input_series": [
        {
          "series": "imgproxy_request_duration_seconds_bucket{job=\"findme-imgproxy\",le=\"0.5\"}",
          "values": "0+0x15"
        },
        {
          "series": "imgproxy_request_duration_seconds_bucket{job=\"findme-imgproxy\",le=\"1\"}",
          "values": "0+0x15"
        },
        {
          "series": "imgproxy_request_duration_seconds_bucket{job=\"findme-imgproxy\",le=\"2.5\"}",
          "values": "0+10x15"
        },
        {
          "series": "imgproxy_request_duration_seconds_bucket{job=\"findme-imgproxy\",le=\"+Inf\"}",
          "values": "0+10x15"
        },
        {
          "series": "imgproxy_requests_total{job=\"findme-imgproxy\"}",
          "values": "0+10x15"
        }
      ],
      "alert_rule_test": [
