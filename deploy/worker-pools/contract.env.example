# Worker-pool design contract; this file does not provision resources or activate feature gates.
# Provisioning consumes explicitly reviewed nonsecret JSON, not this environment example.
# Required provisioning JSON pool_max_size: integer 1 or 2, with no default.
# The approved activation caps each autoscaled pool at one; raising the cap needs review.
# Provisioning/observation JSON requires distinct folder_id (all new worker groups,
# VMs, disks, image, subnet, SG, route, NAT and worker identities/secret) and
# canonical_folder_id (existing VM, application secret, VPC and native Monitoring).
# The WORKLOAD rule and both canonical metric publishers use canonical_folder_id.
# Do not use the CLI profile folder or the canonical folder as a fallback.
WORKER_POOL_CLOUD_ID=b1gmcsmr51o5kvp86l55
WORKER_POOL_FOLDER_ID=
WORKER_POOL_CANONICAL_FOLDER_ID=b1g2qttgfhb4gdunvlge
WORKER_POOL_NETWORK_ID=enpevjgdgdavmrv9ahb8
WORKER_POOL_CANONICAL_VM_ID=epdr5g3p24tdns9890nr
WORKER_POOL_ZONE=ru-central1-b
# Above known IDs/IP are a dated 2026-09-30 read-only snapshot; refresh before apply.
# The empty worker folder ID and all new resource IDs come only from approved creation.
WORKER_POOL_MAX_SIZE=1
WORKER_POOL_PLATFORM=standard-v3
WORKER_POOL_CORES=2
WORKER_POOL_CORE_FRACTION=100
WORKER_POOL_MEMORY_GIB=8
WORKER_POOL_DISK_TYPE=network-ssd
WORKER_POOL_DISK_GIB=32
WORKER_POOL_CONTAINER_CPUS=2
WORKER_POOL_CONTAINER_MEMORY=5g
WORKER_POOL_CONCURRENCY=1
WORKER_POOL_SELFIE_MIN=1
WORKER_POOL_SELFIE_MAX=1
WORKER_POOL_SELFIE_PREEMPTIBLE=False
# A ceiling of two is separately activated only after functional acceptance.
WORKER_POOL_BULK_MIN=0
WORKER_POOL_BULK_MAX=1
WORKER_POOL_BULK_PREEMPTIBLE=True
WORKER_POOL_BULK_IDENTITIES=1/capture_metadata/2,2/generate_preview/1,2/generate_watermarked_preview/1,3/face_embedding/5,1/bib_recognition/1
WORKER_POOL_SELFIE_IDENTITIES=1/selfie_query/2
# Required deployment-selected private address, with no public-address fallback.
# Dated canonical private address; refresh before a reviewed deployment.
WORKER_POOL_PRIVATE_API_IPV4=10.129.0.34
WORKER_POOL_PRIVATE_API_HOSTNAME=findme-photo.ru
WORKER_POOL_PRIVATE_API_PORT=8443
PHOTO_WORKER_API_URL=https://findme-photo.ru:8443/internal/photo-processing/v1
# Each worker receives exactly its pool's identities as PHOTO_WORKER_PROCESSOR_IDENTITIES.
# PHOTO_WORKER_TOKEN and immutable PHOTO_WORKER_BUILD are supplied by approved release tooling.
