          "eval_time": "11m",
          "alertname": "ImgproxyLatencyHigh",
          "exp_alerts": [
            {
              "exp_labels": {
                "project": "findme-photo",
                "severity": "warning"
              },
              "exp_annotations": {
                "summary": "imgproxy five-minute p95 has exceeded 1.5 seconds with enough requests."
