# Non-secret inputs for read-only discovery. Resolve these from the canonical deployment;
# never guess them from a display name or public address.
# The provisioner always uses the reviewed repository artifacts below; there is no SSH-key path
# input. Review these hashes in every dry-run and approval nonce:
# deploy/image-origin/workflow-ssh-key.pub sha256=5cb142386c744da7cc7783a90b499bd79ab5c65ef8ddb10b2e3a70f04f4650de
# deploy/image-origin/cloud-init.sh sha256=da2a712df2f57a7e979ea2dc6cd34bf303a2a34a8bfb7f13f60a444d3eda35a9
CANONICAL_VM_ID=
PRIVATE_MEDIA_S3_BUCKET=
IMAGE_ORIGIN_ZONE_ID=ru-central1-a
IMAGE_ORIGIN_BOOT_IMAGE_ID=
IMAGE_ORIGIN_SSH_SOURCE_CIDR=
IMAGE_ORIGIN_ACCEPTED_PREVIEW_KEY=
IMAGE_ORIGIN_DENIED_ORIGINAL_KEY=
IMAGE_ORIGIN_DENIED_STAGING_KEY=
IMAGE_ORIGIN_PROBE_WRITE_KEY=derivatives/previews/probe/write.jpg

# Required only by --apply. This root-private file persists returned resource IDs.
IMAGE_ORIGIN_CONTRACT_STATE=

# Secrets never belong in this file. --apply consumes the image-delivery-provision projection;
# --probe separately consumes the image-origin projection, both through FINDME_ENV_FILE.

# Provisioning approvals stop after secret-bootstrap, resource-identities, and origin-access.
# origin-access adds only canonical-VM-SG TCP/22 access and requires a fresh dry-run before the
# origin-and-policy phase can mutate the VM, IAM, bucket policy, or credentials.

# Independent workflow variables (set as repository variables, not in this local file):
# VM_HOST=<canonical VM public SSH host>
# VM_USER=<canonical VM SSH user>
# VM_SSH_KNOWN_HOSTS=<reviewed canonical VM host-key line>
# IMAGE_ORIGIN_VM_HOST=<origin private IPv4>
# IMAGE_ORIGIN_VM_USER=<origin SSH user authorized by workflow-ssh-key.pub>
# IMAGE_ORIGIN_SSH_KNOWN_HOSTS=<reviewed private origin host-key line>
